# --- Claude / local tooling (internal, not for publication) ---
# Exclude .claude/ contents but publish the handover skill library (.claude/skills/).
# Use /* (contents) not / (the dir) so the negation can re-include; keep the negation LAST
# so it wins; .CLAUDE/* covers the case-sensitive-FS variant (Linux) harmlessly on Windows.
CLAUDE.md
.claude/*
.CLAUDE/*
!.claude/skills/

# --- Project governance docs (excluded from the public repo per request) ---
CONTRACT.md

# --- ROMs: copyrighted. NEVER publish a ROM. ---
*.gb
*.gbc
*.gba
*.sgb
*.rom
roms/*.gb
roms/*.gbc
roms/*.gba

# --- Emulator save data / generated run artifacts ---
runs/
# per-iteration aria memory snapshots (zipped before each wipe; binary, not for the repo)
aria_memory_archives/
*.sav
*.state
*.sa1
# generated: rendered from the aria game constitution
red_system_prompt.txt
# generated: ViZDoom runtime config written to the working dir
_vizdoom.ini
_vizdoom/

# --- Model weights / downloads: large binaries, regenerable, NEVER commit ---
weights/
*.pt
*.onnx
*.safetensors
# isolated probe envs (torch/clip/yolo) — multi-hundred-MB, regenerable
.venv-probe*/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
*.log
